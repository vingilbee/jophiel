# Copy to .env and fill in. Never commit .env.

# SQLAlchemy DB URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/macrovision

# Echo SQL statements to stdout (local dev only).
DB_ECHO=false

# --- OpenAI (chat, voice transcription, memory, and image VLM) ---
OPENAI_API_KEY=
# Optional overrides:
# CHAT_MODEL=gpt-4.1
# VOICE_CHAT_MODEL=gpt-4.1-mini
# STT_MODEL=gpt-4o-mini-transcribe   # whisper-1 to roll back
# SUBAGENT_MODEL=gpt-4.1-mini
# CHAT_MAX_TOKENS=4096
# SHORT_TERM_MEMORY_MESSAGES=24

# --- Long-term memory ---
# Requires a separate worker: `uv run python -m app.workers.memory`.
# Redis wakes the worker; PostgreSQL keeps the durable job records.
REDIS_URL=redis://localhost:6379/0
# LONG_TERM_MEMORY_ENABLED=true
# MEMORY_MODEL=gpt-6-luna
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_RETRIEVAL_LIMIT=6
# Memory extraction and semantic retrieval use OPENAI_API_KEY below.

# --- WhatsApp Cloud API (optional) ---
# Set all values and expose /api/whatsapp/webhook over HTTPS. Users link their
# account from the app, then send the generated `link CODE` message to WhatsApp.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Human-readable number shown in linking instructions, e.g. +15551234567.
WHATSAPP_DISPLAY_PHONE_NUMBER=
# Pin the Graph API version used by your Meta app.
WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_DEBOUNCE_SECONDS=1.0
# WHATSAPP_MAX_BATCH_SECONDS=3.0

# --- Google / Gmail / Drive / Docs / Slides integration (optional) ---
# Enable Gmail API, Google Drive API, Google Docs API, and Google Slides API
# in the Google Cloud project for this OAuth client.
# Optional: preselect the dedicated agent account during the one-time consent.
# GOOGLE_ACCOUNT_USERNAME=agent@example.com
# GOOGLE_ACCOUNT_PASSWORD is not used: Google APIs require OAuth consent.
# DRIVE_TOOLS_ENABLED=true
# Slide image generation uses OPENAI_API_KEY. Search uses Wikimedia (no key).
# SLIDE_IMAGE_MODEL=gpt-image-2
# Public HTTPS origin routing /api/assets/slide-image/* to this backend.
# Required only to insert generated/uploaded images; not for public search URLs.
# SLIDE_IMAGE_PUBLIC_BASE_URL=https://your-backend.example.com
# From a Google Cloud "Web application" OAuth client. Leave blank to disable
# the integration entirely (the Connect Gmail button then reports unavailable).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI on that OAuth client, character for
# character. Change the host/port if the backend isn't on localhost:8000.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Encrypts stored Google refresh tokens at rest and signs the OAuth state.
# Required whenever the Google integration is enabled. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates existing connections — users must reconnect.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback sends the browser when the flow finishes.
# JSON list of exact browser origins allowed to send credentialed requests.
# Railway example: ["https://your-frontend.example.com"]
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# FRONTEND_BASE_URL=http://localhost:5173
# Set false to keep accounts connected but hide the Gmail tools from the agent.
# GMAIL_TOOLS_ENABLED=true

# --- MacroVision nutrition model (image -> macros) ---
# VLM backend for "combined" mode: "qwen" (local, default) or "openai" (API).
# MACROVISION_VLM_BACKEND=qwen
# With the OpenAI backend this reuses OPENAI_API_KEY from above.
# MACROVISION_OPENAI_MODEL=gpt-4o-mini
# Set false to skip loading any VLM and run regression-only.
# MACROVISION_LOAD_VLM=true
# Blender desktop bridge (requires blender_addon/macrovision_blender_bridge.py)
BLENDER_TOOLS_ENABLED=false
BLENDER_BRIDGE_HOST=127.0.0.1
BLENDER_BRIDGE_PORT=9877
ASSET_MAX_UPLOAD_MB=100

# Real-answer TTS latency tuning (fillers remain off by default).
TTS_FILLERS_ENABLED=false
# (These two are read by the TTS sidecar process, not the backend.)
TTS_STREAM_MIN_CHUNK_LENGTH=16
TTS_STREAM_FIXED_LENGTH_CHUNK=true
# Voice latency timing marks (stage timestamps only; no transcript or audio).
# Report: uv run python scripts/voice_latency_report.py
VOICE_LATENCY_MARKS_ENABLED=true
VOICE_LATENCY_LOG_PATH=var/voice_latency.jsonl

# --- Cognitive live shadow (observational only; never affects responses) ---
# Disabled by default. Capture also refuses to run until a reviewed retention
# period is set. A malformed or inactive CoreMemory makes each captured turn a
# typed `missing_personality_projection` skip.
#
# Reviewed LOCAL CANARY profile (developer machine only). 14 days retention and
# 1.0 sampling are approved ONLY for the local canary; production/staging needs
# a separate rollout decision. Put active values in your uncommitted .env; stop
# the canary with ENABLED=false and SAMPLE_RATE=0.0. Expired records are purged
# hourly while the enabled worker runs (and on its first pass after restart).
# Simple cognition, live (docs/COLUMBINA_LIVE_INTENTION_PATH_DESIGN.md). Both off by default.
# COGNITIVE_LIVE_CHARACTER=true            # her character page + memories typed by whose they are
# COGNITIVE_LIVE_STUDENT=ab                # off | on | ab: Student 1's reading in half the conversations
# COGNITIVE_LIVE_STUDENT_DIR=              # default var/cognitive_simple/teacher-1-2/models-1.0
# COGNITIVE_LIVE_EVENTS_MODEL=             # reads her reply for the notes; default SUBAGENT_MODEL
# COGNITIVE_LIVE_SHADOW_ENABLED=true
# Local-only sampling; never copy 1.0 to staging/production.
# COGNITIVE_LIVE_SHADOW_SAMPLE_RATE=1.0
# COGNITIVE_LIVE_SHADOW_SAMPLING_POLICY_VERSION=shadow-sampling-v0.1
# 14 days is approved for the local canary only.
# COGNITIVE_LIVE_SHADOW_RETENTION_DAYS=14
# Personality source: runtime_mapper (compile the active CoreMemory; default) or
# reviewed_baseline (explicit compatibility only; reads the path below). No fallback.
# COGNITIVE_LIVE_SHADOW_PERSONALITY_SOURCE=runtime_mapper
# COGNITIVE_LIVE_SHADOW_PERSONALITY_BASELINE_PATH=
# COGNITIVE_LIVE_SHADOW_LANGUAGE_TAG=en
# COGNITIVE_LIVE_SHADOW_CORE_MEMORY_NAME=columbina
# COGNITIVE_LIVE_SHADOW_WORKER_LEASE_SECONDS=300
# COGNITIVE_LIVE_SHADOW_WORKER_POLL_SECONDS=2
# COGNITIVE_LIVE_SHADOW_MAX_ATTEMPTS=3
# COGNITIVE_LIVE_SHADOW_QUEUE_NAME=macrovision:cognitive-shadow:wakeups
# Set false in production and run `uv run python -m app.workers.cognitive_shadow`
# as its own process so shadow CPU never shares the chat worker's interpreter.
# COGNITIVE_LIVE_SHADOW_RUN_IN_SHARED_WORKER=true
#
# Required model-backed semantic parser for the shadow Interpretation stage.
# Receives only bounded dialogue text and the code-owned semantic schema; no
# memory, relationship, personality/bias, goal, action, or runtime payload.
# COGNITIVE_SHADOW_SEMANTIC_PARSER_MODEL=gpt-6-luna
# COGNITIVE_SHADOW_SEMANTIC_PARSER_TIMEOUT_SECONDS=20
# Two-call v1: reasoning for the reader (Call 1) only: none | low | medium. Raise the timeout with it.
# COGNITIVE_SHADOW_CALL_ONE_REASONING_EFFORT=none
# Collaborative Content V0 (shadow-only structured proposals; off by default,
# explicit model required, no fallback model):
# COGNITIVE_SHADOW_COLLABORATION_ENABLED=false
# COGNITIVE_SHADOW_COLLABORATION_MODEL=
# COGNITIVE_SHADOW_COLLABORATION_TIMEOUT_SECONDS=25
#
# Realization V0 (shadow-only wording of the selected Action plan). Disabled by
# default; candidates are stored on the shadow trace and never reach chat, tools,
# or memory. Requires live shadow above plus an explicit model id (uses
# OPENAI_API_KEY). No fallback to CHAT_MODEL or any other model: a missing model
# id records provider_unavailable.
# COGNITIVE_SHADOW_REALIZATION_ENABLED=false
# Recommended fast, focused shadow realizer; keep the feature disabled until
# explicitly running a reviewed local shadow canary.
# COGNITIVE_SHADOW_REALIZATION_MODEL=gpt-6-luna
# COGNITIVE_SHADOW_REALIZATION_TIMEOUT_SECONDS=20
# COGNITIVE_SHADOW_REALIZATION_MAX_ATTEMPTS=2
# COGNITIVE_SHADOW_REALIZATION_MAX_CHARACTERS=1200
#
# Dialogue Working Memory V0 (short-term, conversation-scoped dialogue state for
# the cognitive shadow). Disabled by default; shadow-only. Enabling it never
# enables live shadow, Realization, or any live-response change, and it never
# writes long-term, relationship, episodic, core, or learning memory. When
# enabled, `python -m app.workers` runs a dialogue-memory thread and live-shadow
# captures move to cognitive-shadow-capture-v0.3. PostgreSQL is authoritative;
# the optional cache (uses REDIS_URL) never changes results.
# COGNITIVE_DIALOGUE_MEMORY_ENABLED=false
# COGNITIVE_DIALOGUE_MEMORY_BOOTSTRAP_MESSAGES=30
# May lower, never raise, the contract cap of 200.
# COGNITIVE_DIALOGUE_MEMORY_MAX_ITEMS=200
# COGNITIVE_DIALOGUE_MEMORY_CACHE_ENABLED=false
# COGNITIVE_DIALOGUE_MEMORY_CACHE_TTL_SECONDS=3600
# COGNITIVE_DIALOGUE_MEMORY_QUEUE_NAME=macrovision:dialogue-memory:wakeups
# COGNITIVE_DIALOGUE_MEMORY_WORKER_LEASE_SECONDS=120
# COGNITIVE_DIALOGUE_MEMORY_WORKER_POLL_SECONDS=2
# COGNITIVE_DIALOGUE_MEMORY_MAX_ATTEMPTS=5

# Phase 1 appraisal trial: shadow only; explicit model required, no fallback.
COGNITIVE_SHADOW_APPRAISAL_IMPLEMENTATION=deterministic
COGNITIVE_SHADOW_APPRAISAL_MODEL=gpt-6-luna
COGNITIVE_SHADOW_APPRAISAL_TIMEOUT_SECONDS=20

# GPT-6 Luna uses explicit reasoning_effort=none in all three cognitive adapters.

# Two combined shadow calls; staged preserves the existing stage engines.
COGNITIVE_SHADOW_ORCHESTRATION=staged
COGNITIVE_SHADOW_ORCHESTRATION_MAX_OUTPUT_TOKENS=6000

# Compact event appraisal and shared context. Only applies to enabled two_call shadow orchestration.
# cognitive-two-call-v1: Call 1 = typed Interpretation + named Appraisal, Call 2 = candidate selection
# only; content comes from the collaboration provider above and wording from the Realization provider.
COGNITIVE_SHADOW_TWO_CALL_PROTOCOL=context-conditioned-two-call-v0.1

# Desktop agent (docs/DESKTOP_AGENT_IMPLEMENTATION_PLAN.md). Off by default: /api/desktop answers 404
# and the UI hides the panel. Enabling it starts no VM and sends no input by itself.
DESKTOP_AGENT_ENABLED=false
DESKTOP_PROFILES_DIR=desktop_profiles
DESKTOP_MAX_SESSION_SECONDS=7200
DESKTOP_PLAN_MAX_STEPS=12
# Controller relay (`uv run python -m app.ai.desktop.relay`): TLS, LAN address only (never 0.0.0.0).
DESKTOP_CONTROLLER_BIND_HOST=127.0.0.1
DESKTOP_CONTROLLER_PORT=8765
# DESKTOP_CONTROLLER_PUBLIC_HOST=   # what the VM dials, if different from the bind host
DESKTOP_RELAY_DIR=var/desktop_relay
DESKTOP_PAIRING_TTL_SECONDS=600
DESKTOP_PAIRING_MAX_ATTEMPTS=5
# Driver model (stage D): one model call per game step. Never falls back to another model.
DESKTOP_DRIVER_BACKEND=openai
DESKTOP_DRIVER_MODEL=gpt-6-luna
DESKTOP_DRIVER_REASONING_EFFORT=none
DESKTOP_DRIVER_IMAGE_DETAIL=auto
DESKTOP_DRIVER_MAX_STEPS=1500
# Tuning aid, off by default: saves every driver step's screenshot, prompt and reply here.
# DESKTOP_DRIVER_DEBUG_DIR=var/desktop_driver_debug
# Stage G: the Minecraft pack (game_packs/minecraft) as her own player, driven by skills. Off unless an
# owner is set: the pack is one Minecraft account on this machine, so it belongs to one user (their email).
MINECRAFT_PACK_OWNER_EMAIL=
MINECRAFT_PACK_URL=http://127.0.0.1:8790
# The pack's API token: PACK_API_TOKEN from the pack's .env, or empty to read the file the pack writes.
MINECRAFT_PACK_TOKEN=
MINECRAFT_PACK_TOKEN_FILE=../game_packs/minecraft/var/api_token
MINECRAFT_PACK_MAX_DECISIONS=400

# Mind tick recording (app/ai/mind): while a Minecraft pack session is live, the
# worker writes what each ~1 s tick of her mind would see to MIND_TICK_PATH.
# Observation only. Compare gates offline: uv run python scripts/mind_gate_eval.py
MIND_TICK_RECORDING_ENABLED=false
MIND_TICK_PATH=var/mind_ticks.jsonl
# Gates under test: Jev from TypeSafe directly (TYPESAFE_API_KEY) or through
# OpenRouter (OPENROUTER_API_KEY); Strands Decider served locally.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
OPENROUTER_API_KEY=
STRANDS_DECIDER_URL=http://127.0.0.1:8765
# Her mind (docs/COLUMBINA_MIND_DESIGN.md): every ~1 s a gate decides how hard she
# should think (none/react/light/hard). Needs DESKTOP_AGENT_ENABLED; the gate "jev"
# needs TYPESAFE_API_KEY (else OpenAI Decisions is used).
MIND_ENABLED=false
MIND_GATE=jev
MIND_THINK_THRESHOLD=0.7
MIND_QUICK_MODEL=gpt-6-luna
MIND_REACT_MODEL=gpt-4.1-mini
# After a reply in a game: if the game changed while she said it and that made something
# she said wrong, she corrects herself in one short line.
GAME_CORRECTIONS_ENABLED=true
GAME_CORRECTION_MODEL=gpt-6-luna
MIND_QUIET_SECONDS=25
MIND_QUICK_GAP_SECONDS=4
MIND_HARD_GAP_SECONDS=20
# Her planner (docs/COLUMBINA_MIND_DESIGN.md "Planning"): the one author of her Minecraft
# plan. Replies set goals, background turns and hard thoughts don't plan. Needs MIND_ENABLED.
MIND_PLANNER_ENABLED=false
MIND_PLAN_MODEL=gpt-6-luna
MIND_PLAN_REASONING_EFFORT=low
# Hard thinking (docs/COLUMBINA_HARD_THINKING_PLAN.md): every hard thought's input and
# answer go to MIND_HARD_LOG_PATH (replay them with scripts/mind_hard_eval.py).
MIND_HARD_MODEL=gpt-6-luna
MIND_HARD_REASONING_EFFORT=low
MIND_HARD_QUIET_SECONDS=180
MIND_HARD_QUIET_EVERY_SECONDS=300
MIND_HARD_LOG_PATH=var/mind_hard.jsonl
MIND_LOG_PATH=var/mind.jsonl
