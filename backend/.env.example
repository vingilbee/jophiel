# Copy to .env and fill in. Never commit .env.

# SQLAlchemy DB URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/macrovision

# Echo SQL statements to stdout (local dev only).
DB_ECHO=false

# --- OpenAI (chat, voice transcription, memory, and image VLM) ---
OPENAI_API_KEY=
# Optional overrides:
# CHAT_MODEL=gpt-4.1
# VOICE_CHAT_MODEL=gpt-4.1-mini
# SUBAGENT_MODEL=gpt-4.1-mini
# CHAT_MAX_TOKENS=4096
# SHORT_TERM_MEMORY_MESSAGES=24

# --- Long-term memory ---
# Requires a separate worker: `uv run python -m app.workers.memory`.
# Redis wakes the worker; PostgreSQL keeps the durable job records.
REDIS_URL=redis://localhost:6379/0
# LONG_TERM_MEMORY_ENABLED=true
# MEMORY_MODEL=gpt-4o-mini
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_RETRIEVAL_LIMIT=6
# Memory extraction and semantic retrieval use OPENAI_API_KEY below.

# --- WhatsApp Cloud API (optional) ---
# Set all values and expose /api/whatsapp/webhook over HTTPS. Users link their
# account from the app, then send the generated `link CODE` message to WhatsApp.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Human-readable number shown in linking instructions, e.g. +15551234567.
WHATSAPP_DISPLAY_PHONE_NUMBER=
# Pin the Graph API version used by your Meta app.
WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_DEBOUNCE_SECONDS=1.0
# WHATSAPP_MAX_BATCH_SECONDS=3.0

# --- Google / Gmail / Drive / Docs / Slides integration (optional) ---
# Enable Gmail API, Google Drive API, Google Docs API, and Google Slides API
# in the Google Cloud project for this OAuth client.
# Optional: preselect the dedicated agent account during the one-time consent.
# GOOGLE_ACCOUNT_USERNAME=agent@example.com
# GOOGLE_ACCOUNT_PASSWORD is not used: Google APIs require OAuth consent.
# DRIVE_TOOLS_ENABLED=true
# Slide image generation uses OPENAI_API_KEY. Search uses Wikimedia (no key).
# SLIDE_IMAGE_MODEL=gpt-image-2
# Public HTTPS origin routing /api/assets/slide-image/* to this backend.
# Required only to insert generated/uploaded images; not for public search URLs.
# SLIDE_IMAGE_PUBLIC_BASE_URL=https://your-backend.example.com
# From a Google Cloud "Web application" OAuth client. Leave blank to disable
# the integration entirely (the Connect Gmail button then reports unavailable).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI on that OAuth client, character for
# character. Change the host/port if the backend isn't on localhost:8000.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Encrypts stored Google refresh tokens at rest and signs the OAuth state.
# Required whenever the Google integration is enabled. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates existing connections — users must reconnect.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback sends the browser when the flow finishes.
# JSON list of exact browser origins allowed to send credentialed requests.
# Railway example: ["https://your-frontend.example.com"]
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# FRONTEND_BASE_URL=http://localhost:5173
# Set false to keep accounts connected but hide the Gmail tools from the agent.
# GMAIL_TOOLS_ENABLED=true

# --- MacroVision nutrition model (image -> macros) ---
# VLM backend for "combined" mode: "qwen" (local, default) or "openai" (API).
# MACROVISION_VLM_BACKEND=qwen
# With the OpenAI backend this reuses OPENAI_API_KEY from above.
# MACROVISION_OPENAI_MODEL=gpt-4o-mini
# Set false to skip loading any VLM and run regression-only.
# MACROVISION_LOAD_VLM=true
# Blender desktop bridge (requires blender_addon/macrovision_blender_bridge.py)
BLENDER_TOOLS_ENABLED=false
BLENDER_BRIDGE_HOST=127.0.0.1
BLENDER_BRIDGE_PORT=9877
ASSET_MAX_UPLOAD_MB=100

# Real-answer TTS latency tuning (fillers remain off by default).
TTS_FILLERS_ENABLED=false
TTS_STREAM_MIN_CHUNK_LENGTH=8
