{
  "schema_version": "dialogue-memory-design-cases-v0.1",
  "status": "draft_for_human_review",
  "dialogue_memory_contract": "dialogue-working-memory-contract-v0.1",
  "updater": "dialogue-working-memory-updater-v0.1",
  "projection": "dialogue-working-memory-projection-v0.1",
  "description": "Domain-general multi-turn cases for Dialogue Working Memory V0 (DIALOGUE_WORKING_MEMORY_V0_IMPLEMENTATION.md section 24.7). 'pure' cases run the deterministic updater, the turn-local projection, and the real Cognitive Pipeline V0 (schema v0.3) without a database; 'database' cases name the real-PostgreSQL test that exercises them. Expectations pin structural dialogue facts only. Not learning data and not evidence of human-like conversation quality.",
  "target_notation": {
    "entity:<key>": "the entity item with that normalized key",
    "option:<n>": "option n of the active option set",
    "plan": "the active plan",
    "topic:<key>": "the topic item with that normalized key",
    "request:<anchor>": "the request whose exact anchor is given",
    "utterance:user:last": "the most recent user utterance reference",
    "utterance:columbina:last": "the most recent Columbina utterance reference"
  },
  "cases": [
    {
      "case_id": "pronoun-one-antecedent", "kind": "pure", "covers": 1,
      "turns": [["user", "I adopted a puppy named Rex."], ["assistant", "Congratulations!"]],
      "focus": "What should I feed him?",
      "expect": {"cues": [{"kind": "pronoun_singular", "resolution": "resolved", "targets": ["entity:rex"]}]}
    },
    {
      "case_id": "pronoun-two-antecedents", "kind": "pure", "covers": 2,
      "turns": [["user", "I have a dog named Max and a cat named Luna."], ["assistant", "Lovely."]],
      "focus": "What should I feed it?",
      "expect": {"cues": [{"kind": "pronoun_singular", "resolution": "ambiguous", "candidates": ["entity:max", "entity:luna"]}],
                 "action_unknown_referents": 1}
    },
    {
      "case_id": "second-option", "kind": "pure", "covers": 3,
      "turns": [["user", "Suggest a breakfast."], ["assistant", "Here are some options:\n1. Oatmeal\n2. Eggs\n3. Yogurt"]],
      "focus": "Use the second option.",
      "expect": {"cues": [{"kind": "ordinal_option", "resolution": "resolved", "targets": ["option:2"]}],
                 "action_object_types": ["option", "option_set"]}
    },
    {
      "case_id": "continue-with-plan", "kind": "pure", "covers": 4,
      "turns": [["user", "Help me plan my week."], ["assistant", "Here is a plan:\n1. Shop on Monday\n2. Cook on Tuesday"]],
      "focus": "Yes, continue.",
      "expect": {"cues": [{"kind": "continuation", "resolution": "resolved", "targets": ["plan"]}],
                 "action_object_types": ["plan", "plan_step"]}
    },
    {
      "case_id": "continue-without-plan", "kind": "pure", "covers": 5,
      "turns": [["user", "Hi there."], ["assistant", "Hello! How can I help?"]],
      "focus": "Yes, continue.",
      "expect": {"cues": [{"kind": "continuation", "resolution": "no_candidate"}]}
    },
    {
      "case_id": "correct-personal-statement", "kind": "pure", "covers": 6,
      "turns": [["user", "My dog is named Max."], ["assistant", "Hi Max!"]],
      "focus": "No, I meant Charlie, not Max.",
      "expect": {"cues": [{"kind": "correction", "resolution": "resolved", "targets": ["entity:max"]}],
                 "committed_after_focus": {"superseded_entities": ["max"], "current_entities": ["charlie"]}}
    },
    {
      "case_id": "withdraw-request", "kind": "pure", "covers": 7,
      "turns": [["user", "Please draft a meal plan."], ["assistant", "Working on it."]],
      "focus": "Never mind, forget it.",
      "expect": {"cues": [{"kind": "withdrawal", "resolution": "resolved", "targets": ["request:Please draft a meal plan."]}],
                 "committed_after_focus": {"withdrawn_requests": ["Please draft a meal plan."]}}
    },
    {
      "case_id": "return-to-prior-topic", "kind": "pure", "covers": 8,
      "turns": [["user", "Let's talk about protein."], ["assistant", "Sure."],
                ["user", "Speaking of sleep, I sleep badly."], ["assistant", "Sorry to hear."]],
      "focus": "Back to protein, how much do I need?",
      "expect": {"cues": [{"kind": "topic_return", "resolution": "resolved", "targets": ["topic:protein"]}],
                 "action_object_types": ["topic"], "an_eligible_candidate_targets_a_dialogue_object": true, "primary_move_addresses_blocked_request": true}
    },
    {
      "case_id": "question-refers-to-prior-claim", "kind": "pure", "covers": 9,
      "turns": [["user", "I ran 5 km this morning."], ["assistant", "Nice run!"]],
      "focus": "Is that distance enough for a beginner like me?",
      "expect": {"interpretation_propositions": [{"anchor": "I ran 5 km this morning.", "speaker": "user", "epistemic_status": "attributed"}],
                 "action_object_types": ["proposition"], "proposition_objects_asserted_by": "user"}
    },
    {
      "case_id": "what-did-i-say", "kind": "pure", "covers": 10,
      "turns": [["user", "I ran 5 km today."], ["assistant", "Nice run!"]],
      "focus": "What did I just tell you?",
      "expect": {"cues": [{"kind": "prior_user_statement_query", "resolution": "resolved", "targets": ["utterance:user:last"]}],
                 "quoted": ["utterance:user:last"]}
    },
    {
      "case_id": "what-did-you-say", "kind": "pure", "covers": 11,
      "turns": [["user", "What should I eat?"], ["assistant", "Try oatmeal with berries."]],
      "focus": "What did you say before?",
      "expect": {"cues": [{"kind": "prior_assistant_statement_query", "resolution": "resolved", "targets": ["utterance:columbina:last"]}],
                 "quoted": ["utterance:columbina:last"]}
    },
    {
      "case_id": "prior-output-partial", "kind": "pure", "covers": 12,
      "turns": [["user", "Tell me a story."], ["assistant", "Once upon a", {"status": "partial"}]],
      "focus": "What did you say before?",
      "expect": {"cues": [{"kind": "prior_assistant_statement_query", "resolution": "resolved", "targets": ["utterance:columbina:last"]}],
                 "partial_utterances": ["utterance:columbina:last"]}
    },
    {
      "case_id": "prior-generation-failed-invisibly", "kind": "pure", "covers": 13,
      "turns": [["user", "Hello?"], ["assistant", "", {"status": "failed"}]],
      "focus": "What did you say before?",
      "expect": {"cues": [{"kind": "prior_assistant_statement_query", "resolution": "no_candidate"}],
                 "gaps": ["response_failed"]}
    },
    {
      "case_id": "whatsapp-delivery-pending", "kind": "pure", "covers": 14,
      "turns": [["user", "Hi from WhatsApp.", {"channel": "whatsapp"}],
                ["assistant", "Hello!", {"channel": "whatsapp", "deliveries": [[0, "sent"]]}]],
      "focus": "What did you say before?",
      "expect": {"cues": [{"kind": "prior_assistant_statement_query", "resolution": "no_candidate"}],
                 "gaps": ["delivery_pending"]}
    },
    {
      "case_id": "unprompted-assistant-message", "kind": "pure", "covers": 15,
      "turns": [["assistant", "Did you log breakfast today?", {"unprompted": true}]],
      "focus": "Not yet.",
      "expect": {"open_columbina_questions": ["Did you log breakfast today?"], "remembered_unprompted": true}
    },
    {
      "case_id": "history-outside-bootstrap", "kind": "pure", "covers": 16,
      "turns_generated": {"count": 20, "user": "Note {n} about my day.", "assistant": "Thanks."},
      "bootstrap_messages": 30,
      "focus": "What did I just tell you?",
      "expect": {"omissions": [["outside_bootstrap_window", 1, 10]],
                 "cues": [{"kind": "prior_user_statement_query", "resolution": "resolved", "targets": ["utterance:user:last"]}]}
    },
    {
      "case_id": "deleted-source-message", "kind": "database", "covers": 17,
      "test": "tests/test_dialogue_memory_persistence.py::test_deleted_consumed_message_starts_a_typed_reset_segment"
    },
    {
      "case_id": "stale-cache", "kind": "database", "covers": 18,
      "test": "tests/test_dialogue_memory_persistence.py::test_every_cache_mode_yields_the_identical_turn_context"
    },
    {
      "case_id": "shadow-candidate-differs-from-delivered-response", "kind": "database", "covers": 19,
      "test": "tests/test_dialogue_memory_pipeline.py::test_shadow_candidate_never_enters_dialogue_memory"
    },
    {
      "case_id": "two-users-identical-conversations", "kind": "pure", "covers": 20,
      "turns": [["user", "My dog is named Max."], ["assistant", "Hi Max!"]],
      "focus": "What should I feed him?",
      "second_user": true,
      "expect": {"cues": [{"kind": "pronoun_singular", "resolution": "resolved", "targets": ["entity:max"]}],
                 "disjoint_identities": true}
    }
  ]
}
