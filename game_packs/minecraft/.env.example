# Columbina's Minecraft pack (stage G). Copy to .env; every value has a default.

# The world she joins. Must be a LAN or loopback address (public servers are refused).
MC_HOST=127.0.0.1
MC_PORT=25565
# Empty = the newest release Mineflayer supports (26.1.2 with Mineflayer 4.39); the server
# follows it. "auto" asks the server instead. `bun run check` shows what a world runs.
MC_VERSION=
# Java for the server; empty = found automatically (Homebrew openjdk@<n>, java_home, PATH).
MC_JAVA=
MC_USERNAME=Columbina
# offline: our own server with accounts off (scripts/server.js).
# microsoft: her own paid account, needed to join an "Open to LAN" world; prints a sign-in code once.
MC_AUTH=offline
MC_AUTH_CACHE_DIR=var/auth

# Local API (always 127.0.0.1). Leave the token empty to get a fresh one per run in var/api_token.
PACK_API_PORT=8790
PACK_API_TOKEN=

# Watch-only browser view (always 127.0.0.1).
PACK_VIEWER_PORT=8791
PACK_VIEWER_FIRST_PERSON=false
PACK_VIEWER_VIEW_DISTANCE=6

# How far "nearby" reaches, in blocks.
PACK_NEARBY_RADIUS=32
